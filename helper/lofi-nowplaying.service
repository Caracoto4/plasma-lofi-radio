[Unit]
Description=Publish the track lofiradio.ru is playing (for the Lofi Player widget)
Documentation=https://lofiradio.ru
After=network-online.target
Wants=network-online.target
# the widget talks to this service on 127.0.0.1
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/lofiplayer/lofi-nowplaying.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
Nice=10

[Install]
WantedBy=default.target
